{
  "name": "colordleanswer-api",
  "version": "1.0.0",
  "description": "Cloudflare Worker API for colordleanswer.me - Colordle and Colorfle daily answers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create colordleanswer-db",
    "db:migrate": "wrangler d1 execute colordleanswer-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute colordleanswer-db --local --file=./schema.sql",
    "db:backfill": "wrangler d1 execute colordleanswer-db --file=./seed.sql",
    "db:backfill:local": "wrangler d1 execute colordleanswer-db --local --file=./seed.sql",
    "db:seed-today": "tsx scripts/seed-today.ts",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/seedrandom": "^3.0.8",
    "seedrandom": "^3.0.5",
    "typescript": "^5.7.0",
    "wrangler": "^3.99.0"
  }
}
