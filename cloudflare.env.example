# Cloudflare API auth
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare Pages direct upload target
CLOUDFLARE_PAGES_PROJECT_NAME=
CLOUDFLARE_PAGES_PRODUCTION_BRANCH=main

# Worker secrets used for the midnight rebuild dispatch
GITHUB_TOKEN=
GITHUB_REPO=akarohitmishra/colordlebro

# Optional build-time override for the Astro site
PUBLIC_ANSWER_API_BASE=https://colordleanswer-api.wordleanswerofficial.workers.dev
