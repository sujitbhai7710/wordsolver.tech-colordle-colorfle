        <span class="btn btn-blue" style="font-size:0.8rem;padding:0.5rem 1rem;">Open Solver</span>
      </a>

      <a href="/colorfle-solver" class="card" style="text-decoration:none;">
        <div style="display:flex;align-items:center;gap:0.875rem;margin-bottom:1rem;">
          <div style="width:48px;height:48px;border-radius:12px;background:var(--accent-amber);display:flex;align-items:center;justify-content:center;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <div>
            <div class="card-title">Colorfle Solver</div>
            <div style="font-size:0.8rem;color:var(--text-muted);">Hex matching + feedback</div>
          </div>
        </div>
