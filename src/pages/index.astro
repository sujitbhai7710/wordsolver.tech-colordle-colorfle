---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "Colordle Answer",
      "url": "https://colordleanswer.me",
      "logo": "https://colordleanswer.me/favicon.svg",
      "description": "Free daily puzzle solvers and answer helpers for Colordle, Colorfle, and other color games."
    },
    {
      "@type": "WebSite",
      "name": "Colordle Answer",
      "url": "https://colordleanswer.me"
    },
    {
      "@type": "WebPage",
      "name": "Colordle Answer - Free Color Puzzle Solvers & Daily Answers",
      "description": "Get today's Colordle and Colorfle answers instantly. Free solvers, unlimited play, archive lookups, and daily puzzle solutions.",
      "url": "https://colordleanswer.me"
    }
  ]
});
---

<Layout
  title="Colordle Answer - Free Color Puzzle Solvers & Daily Answers"
  description="Get today's Colordle and Colorfle answers instantly. Free solvers, unlimited play, archive lookups, and daily puzzle solutions for color games."
  keywords="colordle answer today, colorfle answer today, colordle solver, colorfle solver, color puzzle solver, daily puzzle answer, colordle archive, colorfle archive"
  schema={schema}
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <span class="hero-badge">Free Puzzle Tools</span>
      <h1>Solve Color Puzzles<br/>Faster Than Ever</h1>
