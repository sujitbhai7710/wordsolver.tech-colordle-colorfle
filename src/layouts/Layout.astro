          <ul>
            <li><a href="/colordle-archive">Colordle Archive</a></li>
            <li><a href="/colorfle-archive">Colorfle Archive</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Unlimited Play</h4>
          <ul>
            <li><a href="/colordle-unlimited">Colordle Unlimited</a></li>
            <li><a href="/colorfle-unlimited">Colorfle Unlimited</a></li>
          </ul>
