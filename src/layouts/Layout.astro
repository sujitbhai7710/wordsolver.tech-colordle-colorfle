---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  keywords?: string;
  ogImage?: string;
  schema?: string;
}

const {
  title,
  description,
  canonical,
  keywords,
  ogImage = '/og-default.png',
  schema,
} = Astro.props;

const siteUrl = 'https://wordsolver.tech';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="author" content="WordSolver" />
  <meta name="theme-color" content="#DC4A2D" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="en" href={canonicalUrl} />
  <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/favicon.ico" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="WordSolver" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@WordSolverTech" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
  <meta name="twitter:image:alt" content={title} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800;900&family=Source+Sans+3:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  {schema && <script type="application/ld+json" set:html={schema} />}

  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg-base: #FAF9F6;
      --bg-card: #FFFFFF;
      --bg-elevated: #FFFFFF;
      --bg-muted: #F5F4F0;
      --bg-hover: #F0EFE9;
      --text-primary: #1C1917;
      --text-secondary: #57534E;
      --text-muted: #A8A29E;
      --text-inverse: #FFFFFF;
      --accent-primary: #DC4A2D;
      --accent-primary-hover: #C73E23;
      --accent-primary-light: rgba(220,74,45,0.06);
      --accent-primary-mid: rgba(220,74,45,0.12);
      --accent-primary-border: rgba(220,74,45,0.2);
      --accent-blue: #1B4965;
      --accent-blue-light: rgba(27,73,101,0.06);
      --accent-blue-mid: rgba(27,73,101,0.12);
      --accent-blue-border: rgba(27,73,101,0.2);
      --accent-teal: #0D7C66;
      --accent-teal-light: rgba(13,124,102,0.06);
      --accent-teal-mid: rgba(13,124,102,0.12);
      --accent-teal-border: rgba(13,124,102,0.2);
      --accent-pink: #BE3A6B;
      --accent-pink-light: rgba(190,58,107,0.06);
      --accent-pink-mid: rgba(190,58,107,0.12);
      --accent-pink-border: rgba(190,58,107,0.2);
      --accent-amber: #D97706;
      --accent-amber-light: rgba(217,119,6,0.06);
      --accent-amber-mid: rgba(217,119,6,0.12);
      --accent-amber-border: rgba(217,119,6,0.2);
      --accent-green: #16A34A;
      --accent-green-light: rgba(22,163,74,0.06);
      --accent-green-mid: rgba(22,163,74,0.12);
      --border-subtle: #E7E5E0;
      --border-medium: #D6D3CE;
      --border-strong: #A8A29E;
      --shadow-xs: 0 1px 2px rgba(28,25,23,0.03);
      --shadow-sm: 0 1px 3px rgba(28,25,23,0.05), 0 1px 2px rgba(28,25,23,0.03);
      --shadow-md: 0 4px 6px -1px rgba(28,25,23,0.06), 0 2px 4px -2px rgba(28,25,23,0.04);
      --shadow-lg: 0 10px 15px -3px rgba(28,25,23,0.07), 0 4px 6px -4px rgba(28,25,23,0.03);
      --shadow-xl: 0 20px 25px -5px rgba(28,25,23,0.08), 0 8px 10px -6px rgba(28,25,23,0.03);
      --shadow-card: 0 1px 3px rgba(28,25,23,0.04), 0 1px 2px rgba(28,25,23,0.02);
      --shadow-card-hover: 0 8px 20px -4px rgba(28,25,23,0.08), 0 4px 6px -2px rgba(28,25,23,0.03);
      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 14px;
      --radius-xl: 20px;
      --radius-2xl: 24px;
      --radius-full: 9999px;
      --font-display: 'Playfair Display', Georgia, 'Times New Roman', serif;
      --font-body: 'Source Sans 3', 'Segoe UI', sans-serif;
    }

    body {
      font-family: var(--font-body);
      background: var(--bg-base);
      color: var(--text-primary);
      line-height: 1.7;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Subtle grain texture overlay */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 9999;
      opacity: 0.015;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    }

    a { color: var(--accent-primary); text-decoration: none; transition: color 0.2s; }
    a:hover { color: var(--accent-primary-hover); }

    .container {
      max-width: 1140px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* ===== NAVIGATION ===== */
    .nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(250, 249, 246, 0.92);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border-bottom: 1px solid var(--border-subtle);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1.5rem;
      max-width: 1140px;
      margin: 0 auto;
    }

    .nav-logo {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--text-primary);
      letter-spacing: -0.03em;
      display: flex;
      align-items: center;
      gap: 0.625rem;
      text-decoration: none;
    }

    .nav-logo:hover { color: var(--text-primary); }

    .nav-logo-mark {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: var(--accent-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      position: relative;
      overflow: hidden;
    }

    .nav-logo-mark::after {
      content: '';
      position: absolute;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: rgba(255,255,255,0.3);
      top: -2px;
      right: -2px;
    }

    .nav-links {
      display: flex;
      gap: 0.25rem;
      list-style: none;
      align-items: center;
    }

    .nav-links > li > a {
      color: var(--text-secondary);
      font-size: 0.875rem;
      font-weight: 600;
      transition: all 0.2s;
      padding: 0.5rem 0.875rem;
      border-radius: var(--radius-md);
      white-space: nowrap;
    }

    .nav-links > li > a:hover {
      color: var(--accent-primary);
      background: var(--accent-primary-light);
    }

    /* CLICK-BASED DROPDOWN - not hover */
    .nav-dropdown {
      position: relative;
    }

    .nav-dropdown-btn {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      color: var(--text-secondary);
      font-family: var(--font-body);
      font-size: 0.875rem;
      font-weight: 600;
      padding: 0.5rem 0.875rem;
      border-radius: var(--radius-md);
      border: none;
      background: none;
      cursor: pointer;
      transition: all 0.2s;
    }

    .nav-dropdown-btn:hover,
    .nav-dropdown-btn.active {
      color: var(--accent-primary);
      background: var(--accent-primary-light);
    }

    .nav-dropdown-btn svg {
      width: 14px;
      height: 14px;
      transition: transform 0.2s;
    }

    .nav-dropdown-btn.active svg {
      transform: rotate(180deg);
    }

    .nav-dropdown-menu {
      display: none;
      position: absolute;
      top: calc(100% + 6px);
      left: 50%;
      transform: translateX(-50%);
      background: var(--bg-elevated);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 0.5rem;
      min-width: 210px;
      box-shadow: var(--shadow-xl);
      z-index: 200;
      animation: dropdownReveal 0.15s ease;
    }

    .nav-dropdown-menu.open {
      display: block;
    }

    @keyframes dropdownReveal {
      from { opacity: 0; transform: translateX(-50%) translateY(-4px); }
      to { opacity: 1; transform: translateX(-50%) translateY(0); }
    }

    .nav-dropdown-menu a {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.625rem 0.875rem;
      border-radius: var(--radius-sm);
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--text-secondary);
      transition: all 0.15s;
    }

    .nav-dropdown-menu a:hover {
      background: var(--bg-muted);
      color: var(--accent-primary);
    }

    .nav-dropdown-menu a .menu-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .nav-mobile-btn {
      display: none;
      background: none;
      border: none;
      color: var(--text-primary);
      font-size: 1.5rem;
      cursor: pointer;
      padding: 0.25rem;
    }

    @media (max-width: 960px) {
      .nav-links { display: none; }
      .nav-links.active {
        display: flex;
        flex-direction: column;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: rgba(250, 249, 246, 0.98);
        backdrop-filter: blur(20px);
        padding: 0.75rem 1rem;
        gap: 0.125rem;
        border-bottom: 1px solid var(--border-subtle);
        box-shadow: var(--shadow-lg);
      }
      .nav-links.active .nav-dropdown-menu {
        display: none;
        position: static;
        transform: none;
        box-shadow: none;
        border: none;
        padding: 0 0 0 1.25rem;
        min-width: auto;
        animation: none;
      }
      .nav-links.active .nav-dropdown-menu.open {
        display: block;
      }
      .nav-mobile-btn { display: block; }
    }

    /* ===== HERO ===== */
    .hero {
      padding: 4.5rem 0 2.5rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: -40%;
      left: 10%;
      width: 280px;
      height: 280px;
      border-radius: 50%;
      background: var(--accent-primary);
      opacity: 0.04;
      filter: blur(80px);
      pointer-events: none;
    }

    .hero::after {
      content: '';
      position: absolute;
      top: -20%;
      right: 5%;
      width: 200px;
      height: 200px;
      border-radius: 50%;
      background: var(--accent-blue);
      opacity: 0.04;
      filter: blur(60px);
      pointer-events: none;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.375rem 1rem;
      border-radius: var(--radius-full);
      background: var(--accent-primary-light);
      border: 1px solid var(--accent-primary-border);
      font-size: 0.6875rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--accent-primary);
      margin-bottom: 1.5rem;
    }

    .hero h1 {
      font-family: var(--font-display);
      font-size: clamp(2.5rem, 5.5vw, 4rem);
      font-weight: 900;
      line-height: 1.08;
      margin-bottom: 1.25rem;
      color: var(--text-primary);
      letter-spacing: -0.03em;
    }

    .hero p {
      font-size: 1.1rem;
      color: var(--text-secondary);
      max-width: 580px;
      margin: 0 auto 2rem;
      line-height: 1.75;
      font-weight: 400;
    }

    /* ===== CARDS ===== */
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: 1.75rem;
      transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      position: relative;
      box-shadow: var(--shadow-card);
    }

    .card:hover {
      box-shadow: var(--shadow-card-hover);
      border-color: var(--border-medium);
      transform: translateY(-3px);
    }

    .card-title {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      color: var(--text-primary);
      letter-spacing: -0.01em;
    }

    .card-desc {
      color: var(--text-secondary);
      font-size: 0.9rem;
      line-height: 1.7;
      margin-bottom: 1.25rem;
    }

    /* ===== BUTTONS ===== */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.7rem 1.5rem;
      border-radius: var(--radius-md);
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 0.8125rem;
      cursor: pointer;
      transition: all 0.2s;
      border: none;
      text-decoration: none;
      letter-spacing: 0.01em;
    }

    .btn-primary {
      background: var(--accent-primary);
      color: white;
      box-shadow: 0 2px 8px rgba(220,74,45,0.25);
    }

    .btn-primary:hover {
      background: var(--accent-primary-hover);
      transform: translateY(-1px);
      box-shadow: 0 4px 14px rgba(220,74,45,0.3);
      color: white;
    }

    .btn-secondary {
      background: var(--bg-card);
      color: var(--text-primary);
      border: 1.5px solid var(--border-medium);
      box-shadow: var(--shadow-xs);
    }

    .btn-secondary:hover {
      background: var(--bg-muted);
      border-color: var(--border-strong);
      color: var(--text-primary);
    }

    .btn-teal {
      background: var(--accent-teal);
      color: white;
      box-shadow: 0 2px 8px rgba(13,124,102,0.25);
    }

    .btn-teal:hover {
      background: #0A6B58;
      color: white;
      transform: translateY(-1px);
    }

    .btn-blue {
      background: var(--accent-blue);
      color: white;
      box-shadow: 0 2px 8px rgba(27,73,101,0.25);
    }

    .btn-blue:hover {
      background: #153D54;
      color: white;
      transform: translateY(-1px);
    }

    .btn-pink {
      background: var(--accent-pink);
      color: white;
      box-shadow: 0 2px 8px rgba(190,58,107,0.25);
    }

    .btn-pink:hover {
      background: #A0315C;
      color: white;
      transform: translateY(-1px);
    }

    /* ===== GRID ===== */
    .grid-2 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.25rem;
    }

    .grid-3 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1rem;
    }

    /* ===== CONTENT SECTION ===== */
    .content-section {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-2xl);
      padding: 2.5rem;
      margin-bottom: 1.5rem;
      box-shadow: var(--shadow-sm);
    }

    .content-section h2 {
      font-family: var(--font-display);
      font-size: 1.6rem;
      font-weight: 800;
      margin-bottom: 1.125rem;
      color: var(--text-primary);
      letter-spacing: -0.02em;
    }

    .content-section h3 {
      font-family: var(--font-display);
      font-size: 1.2rem;
      font-weight: 700;
      margin: 1.75rem 0 0.75rem;
      color: var(--text-primary);
    }

    .content-section p {
      color: var(--text-secondary);
      line-height: 1.8;
      margin-bottom: 1rem;
      font-size: 0.95rem;
    }

    .content-section ul, .content-section ol {
      color: var(--text-secondary);
      line-height: 1.8;
      padding-left: 1.5rem;
      margin-bottom: 1rem;
    }

    .content-section li { margin-bottom: 0.375rem; }

    /* ===== AUTHOR CARD ===== */
    .author-card {
      display: flex;
      gap: 1rem;
      align-items: center;
      padding: 1.25rem;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-sm);
      margin: 2rem 0;
    }

    .author-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: var(--accent-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 1rem;
      color: white;
      flex-shrink: 0;
    }

    .author-name {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1rem;
      color: var(--text-primary);
    }

    .author-desc {
      font-size: 0.8rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* ===== CSS-ONLY ANSWER REVEAL ===== */
    .reveal-checkbox {
      position: absolute;
      opacity: 0;
      width: 0;
      height: 0;
      pointer-events: none;
    }

    .reveal-label {
      cursor: pointer;
      transition: all 0.3s;
    }

    .reveal-label:hover {
      transform: scale(1.02);
    }

    .reveal-content {
      display: none;
      animation: revealFadeIn 0.4s ease;
    }

    .reveal-checkbox:checked ~ .reveal-content {
      display: block;
    }

    .reveal-checkbox:checked ~ .reveal-label {
      display: none;
    }

    @keyframes revealFadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ===== FOOTER ===== */
    .footer {
      background: var(--text-primary);
      padding: 3.5rem 0 2rem;
      margin-top: 4rem;
      color: rgba(255,255,255,0.7);
    }

    .footer-inner {
      max-width: 1140px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 2rem;
      margin-bottom: 2.5rem;
    }

    .footer-col h4 {
      font-family: var(--font-body);
      font-weight: 700;
      margin-bottom: 1rem;
      color: white;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .footer-col ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .footer-col a {
      color: rgba(255,255,255,0.55);
      font-size: 0.8125rem;
      transition: color 0.2s;
    }

    .footer-col a:hover { color: var(--accent-primary); }

    .footer-bottom {
      border-top: 1px solid rgba(255,255,255,0.1);
      padding-top: 1.5rem;
      text-align: center;
      color: rgba(255,255,255,0.35);
      font-size: 0.75rem;
    }

    /* ===== PAGE HEADER ===== */
    .page-header {
      padding: 2.75rem 0 1.5rem;
      text-align: center;
    }

    .page-header h1 {
      font-family: var(--font-display);
      font-size: clamp(1.85rem, 4vw, 2.75rem);
      font-weight: 900;
      margin-bottom: 0.75rem;
      color: var(--text-primary);
      letter-spacing: -0.03em;
    }

    .page-header p {
      font-size: 1.05rem;
      color: var(--text-secondary);
      max-width: 560px;
      margin: 0 auto;
      line-height: 1.7;
    }

    /* ===== MISC ===== */
    @keyframes spin { to { transform: rotate(360deg); } }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .animate-in { animation: fadeInUp 0.5s ease forwards; }

    /* Badge pills */
    .pill {
      display: inline-flex;
      align-items: center;
      padding: 0.2rem 0.625rem;
      border-radius: var(--radius-full);
      font-size: 0.65rem;
      font-weight: 700;
    }

    .pill-primary {
      background: var(--accent-primary-light);
      border: 1px solid var(--accent-primary-border);
      color: var(--accent-primary);
    }

    .pill-teal {
      background: var(--accent-teal-light);
      border: 1px solid var(--accent-teal-border);
      color: var(--accent-teal);
    }

    .pill-amber {
      background: var(--accent-amber-light);
      border: 1px solid var(--accent-amber-border);
      color: var(--accent-amber);
    }

    .pill-pink {
      background: var(--accent-pink-light);
      border: 1px solid var(--accent-pink-border);
      color: var(--accent-pink);
    }

    .pill-blue {
